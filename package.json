{
  "name": "lomi",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "pnpm sdk:verify && tsc --noEmit && pnpm ai:check",
    "test": "node --experimental-strip-types --test tests/*.test.ts && pnpm ai:test",
    "test:ui": "pnpm --filter lomi-plugin-fixture build && playwright test",
    "test:ui:webkit": "pnpm test:ui --config=playwright.webkit.config.ts",
    "format": "prettier --write src tests *.ts *.json *.md .github/*.md .github/workflows/*.yml scripts/*.mjs docs/*.md releases/*.md packages themes vendor",
    "format:check": "prettier --check src tests *.ts *.json *.md .github/*.md .github/workflows/*.yml scripts/*.mjs docs/*.md releases/*.md packages themes vendor",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "icon:macos": "node scripts/build-macos-icon.mjs",
    "release:check": "node scripts/check-release.mjs",
    "tauri": "tauri",
    "ai:prepare": "node scripts/prepare-ai-runtime.mjs",
    "ai:check": "pnpm --filter @lomi-dev/ai-runtime check",
    "ai:test": "pnpm --filter @lomi-dev/ai-runtime test",
    "sdk:test": "node --experimental-strip-types --test tests/plugin-contract.test.ts",
    "sdk:verify": "node scripts/check-plugin-sdk.mjs",
    "sdk:sync-contract": "node scripts/check-plugin-sdk.mjs --sync",
    "sdk:test:consumer": "node scripts/test-plugin-sdk.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.108",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "7.0.105",
    "dockview": "8.3.1",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.41.0",
    "mitt": "3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-slot-fill": "file:vendor/react-slot-fill",
    "remark-gfm": "^4.0.1",
    "xterm-theme": "1.1.0",
    "@lomi-dev/plugin-sdk": "file:vendor/plugin-sdk/lomi-dev-plugin-sdk-1.1.0-alpha.1.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "ajv": "8.17.1"
  }
}
