{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "runner": {
      "cmd": "cargo",
      "args": [
        "--config",
        "target.'cfg(target_os = \"macos\")'.runner = [\"sh\", \"../scripts/run-macos-dev.sh\"]"
      ]
    },
    "beforeDevCommand": "pnpm ai:prepare && pnpm icon:macos && pnpm dev",
    "beforeBuildCommand": "pnpm icon:macos && pnpm ai:prepare && pnpm build",
    "beforeBundleCommand": "pnpm icon:macos"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lomi",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 420,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 24
        },
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "macOS": {
      "hardenedRuntime": true,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 720,
          "height": 480
        },
        "appPosition": {
          "x": 192,
          "y": 312
        },
        "applicationFolderPosition": {
          "x": 528,
          "y": 312
        }
      },
      "files": {
        "Resources/Assets.car": "target/macos-icon/Assets.car"
      },
      "entitlements": "ai-runtime.entitlements.plist"
    }
  }
}
