        "box-shadow": "none"
      },
      ".modal .modal-surface > header": {
        "flex-shrink": "0",
        "gap": "12px",
        "align-items": "center",
        "padding": "var(--modal-heading-padding)",
        "border-bottom": "0"
      },
      ".modal .button-danger, .modal .button.text-error, .modal .button.danger": {
