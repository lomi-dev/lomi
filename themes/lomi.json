        "border-color": "var(--color-error)"
      },
      ".modal .button-danger:active:not(:disabled), .modal .button.text-error:active:not(:disabled), .modal .button.danger:active:not(:disabled)": {
        "background": "color-mix(in srgb, var(--color-error) 24%, var(--lomi-danger-background))"
      },
      ".modal-surface > .dialog-body": {
        "padding": "12px 24px 24px",
        "overflow-y": "auto",
        "min-height": "0"
      },
      ".modal-surface > p, .modal-surface > .dialog-body p": {
        "font-size": "14px",
        "line-height": "1.65",
        "color": "var(--color-surface-variant-text)",
        "overflow-wrap": "anywhere",
        "text-wrap": "pretty"
      },
      ".modal-surface > p": {
        "font-size": "14px",
        "line-height": "1.65",
        "color": "var(--color-surface-variant-text)",
        "overflow-wrap": "anywhere",
        "text-wrap": "pretty",
        "margin": "12px 24px 0"
      },
      ".modal-surface > p:last-of-type": {
        "margin-bottom": "24px"
      },
      ".modal-surface > .dialog-body p": {
        "margin": "0 0 16px"
      },
      ".modal-surface > .dialog-body p:last-child": {
        "margin-bottom": "0"
      },
      ".modal-surface > .editor-confirm-path": {
        "background": "var(--color-background)",
        "padding": "12px 14px",
        "border-radius": "8px",
        "font-family": "var(--font-family-mono)",
