    "editor": {
      "syntax": {
        "keyword": {
          "color": "var(--color-info)",
          "fontWeight": 700
        },
        "type": {
          "color": "var(--lomi-syntax-type)"
        },
        "function": {
          "color": "var(--color-warning)"
        },
        "string": {
          "color": "var(--lomi-success)"
        },
        "number": {
          "color": "var(--color-info)"
        },
        "comment": {
          "color": "var(--color-surface-variant-text)",
          "fontStyle": "normal"
        },
        "variable": {
          "color": "var(--editor-foreground)"
        },
        "property": {
          "color": "var(--color-background-text)"
        },
        "operator": {
          "color": "var(--color-surface-variant-text)"
        },
        "punctuation": {
          "color": "var(--color-surface-variant-text)"
        },
        "heading": {
          "color": "var(--editor-foreground)",
          "fontWeight": 700
        },
        "link": {
          "color": "var(--color-accent-text)",
          "textDecoration": "underline"
        },
        "invalid": {
          "color": "var(--color-error)"
        },
        "strong": {
          "fontWeight": 700
        },
        "emphasis": {
